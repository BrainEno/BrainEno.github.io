# The site builds to plain files; the only variables that matter are the ones
# baked in at build time.

# Public origin of the deployed site. Used for canonical URLs, sitemap.xml,
# robots.txt and Open Graph / JSON-LD images — a static host cannot read env
# vars at request time, so this has to be set when building for a deploy.
NEXT_PUBLIC_SITE_URL=https://BrainEno.github.io

# Leave unset (or empty) for GitHub Pages user sites (BrainEno.github.io) and
# custom domains served at the root. Set ONLY when hosting under a sub-path
# (e.g. a GitHub Pages project site at `/<repo>`), with a leading slash and no
# trailing slash:
# NEXT_PUBLIC_BASE_PATH=/subpath
